{
    "name": "laminas-api-tools/api-tools-versioning",
    "description": "Laminas Module providing listeners and route prototypes for implementing API versioning",
    "license": "BSD-3-Clause",
    "keywords": [
        "laminas",
        "api-tools",
        "module",
        "rest"
    ],
    "homepage": "https://api-tools.getlaminas.org",
    "support": {
        "docs": "https://api-tools.getlaminas.org/documentation",
        "issues": "https://github.com/laminas-api-tools/api-tools-versioning/issues",
        "source": "https://github.com/laminas-api-tools/api-tools-versioning",
        "rss": "https://github.com/laminas-api-tools/api-tools-versioning/releases.atom",
        "chat": "https://laminas.dev/chat",
        "forum": "https://discourse.laminas.dev"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.2.99"
        }
    },
    "extra": {
        "laminas": {
            "module": "Laminas\\ApiTools\\Versioning"
        }
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "laminas/laminas-eventmanager": "^3.15",
        "laminas/laminas-http": "^2.23",
        "laminas/laminas-modulemanager": "^2.19",
        "laminas/laminas-mvc": "^3.8",
        "laminas/laminas-router": "^3.16",
        "laminas/laminas-servicemanager": "^3.24",
        "laminas/laminas-stdlib": "^3.21",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3",
        "phpspec/prophecy-phpunit": "^2.1",
        "phpunit/phpunit": "^10",
        "psalm/plugin-phpunit": "^0.19",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Laminas\\ApiTools\\Versioning\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaminasTest\\ApiTools\\Versioning\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "static-analysis": "psalm --shepherd --stats",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    },
    "conflict": {
        "zfcampus/zf-versioning": "*"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/datasage/laminas-mvc"
        }
    ]
}
